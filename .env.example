# The solution API is fail-closed. Enable only after the GoClaw license,
# retention/deletion gate, pinned contract fixture, and production secrets pass.
SOLUTION_CHAT_ENABLED=false
PUBLIC_SOLUTION_CHAT_ENABLED=false
# Local preview only. Production rejects this mode and still requires HTTPS + Upstash.
SOLUTION_CHAT_LOCAL_DEV=false

# Exact comma-separated origins with no paths, wildcards, or trailing slashes.
SOLUTION_ALLOWED_ORIGINS=

# Generate independent 32-byte random secrets; encode as 64 lowercase hex.
SOLUTION_SESSION_SECRET_HEX=
SOLUTION_SESSION_TTL_SECONDS=86400

# Distributed rate limiting and idempotency. There is no in-memory production fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SOLUTION_REDIS_NAMESPACE=htlabs-solution-v1

# GoClaw LLM webhook, bound to the HTLabs consultant agent and require_hmac=true.
GOCLAW_BASE_URL=
GOCLAW_WEBHOOK_ID=
# Raw one-time hmac_signing_key returned by GoClaw create/rotate (wh_ + 39 base32 chars).
GOCLAW_WEBHOOK_HMAC_KEY=
GOCLAW_API_CONTRACT=goclaw-webhook-llm-hmac-v1@2f3d68e
GOCLAW_TIMEOUT_MS=25000
