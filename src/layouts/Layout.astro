---
import '../styles/global.css';
const { title = 'HTLabs — Giải Pháp AI Toàn Diện' } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="description" content="HTLabs cung cấp giải pháp AI toàn diện cho doanh nghiệp: chatbot đa kênh, workflow agent, CRM thông minh và triển khai bảo mật." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js" is:inline></script>
    <title>{title}</title>
  </head>
  <body class="bg-[#fdfdfc] text-black">
    <slot />
    <script>
      import '../i18n/i18n-runtime';
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
