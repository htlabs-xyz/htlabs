---
import SiteHeader from './SiteHeader.astro';

type Product = {
  name: string;
  category: string;
  description: string;
  cover: string;
  coverAlt: string;
  href: string;
  cta: string;
  tags: string[];
  status?: string;
};

const products: Product[] = [
  {
    name: 'Triển khai & tích hợp hệ thống quản trị và vận hành thông minh',
    category: 'Odoo / Medusa',
    description: 'Thiết kế, triển khai và tích hợp hệ thống bán hàng, kho vận, CRM, thương mại điện tử và các quy trình vận hành trên Odoo, Medusa.',
    cover: '/product-covers/odoo-medusa-real.webp',
    coverAlt: 'Giao diện thực tế của hệ thống quản trị Odoo và nền tảng thương mại Medusa',
    href: '/#contact',
    cta: 'Liên hệ',
    tags: ['Odoo', 'Medusa', 'ERP & Commerce'],
  },
  {
    name: 'YanAI',
    category: 'Nền tảng AI hình ảnh self-hosted',
    description: 'Hệ thống tạo, chỉnh sửa và quản lý hình ảnh AI với workbench trực tuyến, thư viện prompt, API tương thích OpenAI, quản lý model, kênh và kho ảnh.',
    cover: '/product-covers/yanai-real.webp',
    coverAlt: 'Giao diện thực tế của YanAI Image Studio và thư viện prompt',
    href: 'https://yan.htlabs.xyz',
    cta: 'Trải nghiệm YanAI',
    tags: ['OpenAI-compatible API', 'Image Editing', 'Self-hosted'],
  },
  {
    name: 'Marketing Workflow',
    category: 'Marketing Automation',
    description: 'Thiết kế workflow marketing đa kênh, tự động nuôi dưỡng lead, vận hành chiến dịch và đồng bộ dữ liệu về CRM.',
    cover: '/product-covers/marketing-workflow.svg',
    coverAlt: 'Giao diện minh họa quy trình marketing tự động đa kênh',
    href: '/#contact',
    cta: 'Liên hệ',
    tags: ['Workflow', 'Lead Nurturing', 'CRM'],
  },
  {
    name: 'Vortex',
    category: 'MCP Hub',
    description: 'Trung tâm quản lý và kết nối MCP server, giúp AI agent khám phá công cụ, dữ liệu và hành động trên một lớp tích hợp thống nhất.',
    cover: '/product-covers/vortex-real.webp',
    coverAlt: 'Giao diện thực tế của Vortex với nền tảng kết nối, OAuth scopes và trạng thái tích hợp',
    href: '/#contact',
    cta: 'Liên hệ',
    tags: ['MCP', 'AI Agents', 'Integrations'],
  },
  {
    name: 'AI Chatbot',
    category: 'AI đa kênh',
    description: 'Chatbot AI tư vấn và chăm sóc khách hàng 24/7, kết nối website, mạng xã hội và dữ liệu CRM của doanh nghiệp.',
    cover: '/product-covers/ai-chatbot.svg',
    coverAlt: 'Giao diện minh họa chatbot AI tư vấn khách hàng đa kênh',
    href: '/#contact',
    cta: 'Liên hệ',
    tags: ['Omnichannel', 'Customer Care', 'CRM'],
    status: 'Đang phát triển',
  },
  {
    name: 'AI Livestream',
    category: 'Live Commerce',
    description: 'Giải pháp livestream bán hàng bằng AI với host ảo, phản hồi bình luận và hỗ trợ chốt đơn tự động.',
    cover: '/product-covers/ai-livestream.svg',
    coverAlt: 'Giao diện minh họa giải pháp AI Livestream bán hàng',
    href: '/#contact',
    cta: 'Liên hệ',
    tags: ['Digital Human', 'Live Commerce'],
    status: 'Đang phát triển',
  },
  {
    name: 'Nocturne',
    category: 'Ví Midnight',
    description: 'Ví trình duyệt tự lưu ký cho Midnight Network, tập trung vào quyền riêng tư và trải nghiệm Web3 an toàn.',
    cover: '/product-covers/nocturne-real.png',
    coverAlt: 'Giao diện dashboard thực tế của ví Midnight Nocturne',
    href: 'https://github.com/htlabs-xyz/nocturne',
    cta: 'Khám phá Nocturne',
    tags: ['Midnight', 'Web3 Wallet'],
  },
  {
    name: 'CIP-68 Generator',
    category: 'Công cụ Cardano',
    description: 'Công cụ tạo tài sản động, token và NFT theo tiêu chuẩn CIP-68 trên blockchain Cardano.',
    cover: '/product-covers/cip68-real.png',
    coverAlt: 'Giao diện thực tế của công cụ CIP-68 Generator',
    href: 'https://github.com/htlabs-xyz/cip68generator',
    cta: 'Mở CIP-68 Generator',
    tags: ['Cardano', 'CIP-68', 'Token & NFT'],
  },
];

---

<main class="premium-page min-h-screen w-full overflow-x-hidden bg-white text-black">
  <SiteHeader currentPage="products" />

  <section id="product-grid" class="mx-auto w-full max-w-[1220px] scroll-mt-28 px-5 py-16 md:px-8 md:py-24">
    <div>
      <div>
        <p class="text-[13px] font-bold uppercase tracking-[0.16em] text-[#006f77]">Danh mục sản phẩm</p>
        <h2 class="mt-4 max-w-[900px] text-[32px] font-semibold leading-[1.16] md:text-[52px]">Những sản phẩm HTLabs đã triển khai</h2>
      </div>
    </div>

    <div class="mt-14 grid gap-7 md:grid-cols-2">
      {products.map((product) => (
        <article class="product-card overflow-hidden rounded-[30px] border border-black/10 bg-white shadow-[0_20px_54px_rgba(0,0,0,0.07)]">
          <button type="button" data-product-preview data-image={product.cover} data-alt={product.coverAlt} data-title={product.name} aria-haspopup="dialog" aria-label={`Xem ảnh ${product.name}`} class="group relative block w-full cursor-zoom-in overflow-hidden bg-[#eef3f8] text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0054c1]">
            <img src={product.cover} alt={product.coverAlt} width="1200" height="750" loading="lazy" class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
            <span class="absolute right-4 top-4 inline-flex items-center gap-2 rounded-full bg-black/70 px-3 py-2 text-[12px] font-bold text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
              <iconify-icon icon="solar:magnifer-zoom-in-linear" aria-hidden="true" class="text-lg"></iconify-icon>
              Phóng to
            </span>
          </button>
          <div class="p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-[#eef5ff] px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.08em] text-[#0054c1]">{product.category}</span>
                {product.status && (
                  <span class="rounded-full bg-[#fff0e6] px-3 py-1.5 text-[12px] font-bold text-[#b54708]">{product.status}</span>
                )}
              </div>
              <div class="flex flex-wrap gap-2">
                {product.tags.map((tag) => (
                  <span class="rounded-full border border-black/10 px-3 py-1 text-[12px] font-semibold text-black/55">{tag}</span>
                ))}
              </div>
            </div>
            <h3 class="mt-6 text-[29px] font-semibold leading-[1.15] md:text-[36px]">{product.name}</h3>
            <p class="mt-4 text-[16px] font-medium leading-[1.65] text-black/68 md:text-[17px]">{product.description}</p>
            <a href={product.href} target={product.href.startsWith('http') ? '_blank' : undefined} rel={product.href.startsWith('http') ? 'noreferrer' : undefined} class="mt-7 inline-flex min-h-11 items-center gap-2 text-[15px] font-bold text-[#0054c1] underline decoration-[#0054c1]/25 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0054c1]">
              {product.cta}
              <iconify-icon icon="solar:arrow-up-right-linear" aria-hidden="true" class="text-xl"></iconify-icon>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <dialog id="product-preview-dialog" aria-labelledby="product-preview-title" class="preview-dialog m-auto w-[calc(100%-2rem)] max-w-[1320px] bg-transparent p-0">
    <div class="overflow-hidden rounded-[24px] bg-white shadow-2xl">
      <div class="flex min-h-16 items-center justify-between gap-4 border-b border-black/10 px-5 py-3 md:px-6">
        <h2 id="product-preview-title" class="text-[16px] font-bold leading-tight md:text-[18px]"></h2>
        <button type="button" data-preview-close aria-label="Đóng ảnh xem trước" class="grid size-11 shrink-0 place-items-center rounded-full border border-black/10 text-black transition-colors hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0054c1]">
          <iconify-icon icon="solar:close-circle-linear" aria-hidden="true" class="text-2xl"></iconify-icon>
        </button>
      </div>
      <div class="grid max-h-[calc(100vh-8rem)] place-items-center overflow-auto bg-[#eef3f8] p-2 md:p-4">
        <img data-preview-image alt="" class="max-h-[calc(100vh-10rem)] w-auto max-w-full rounded-xl object-contain" />
      </div>
    </div>
  </dialog>

  <footer class="mx-auto w-full max-w-[1220px] px-5 pb-12 pt-10 md:px-8 md:pb-16 md:pt-14">
    <div class="grid gap-10 border-t border-black/10 pt-10 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <a href="/" aria-label="Về trang chủ HTLabs">
          <img src="/figma-assets/htlabs-logo-footer.svg" alt="HTLabs" class="h-auto w-[150px] md:w-[176px]" />
        </a>
        <p class="mt-6 max-w-[480px] text-[15px] font-medium leading-[1.6] text-black/68 md:text-[16px]">Nghiên cứu và phát triển sản phẩm tại giao điểm của blockchain, AI và công nghệ ứng dụng.</p>
      </div>
      <nav aria-label="Điều hướng chân trang" class="flex flex-wrap gap-x-8 gap-y-3 text-[15px] font-semibold md:justify-end">
        <a href="/" class="hover:text-[#0054c1]">Trang chủ</a>
        <a href="/products" aria-current="page" class="text-[#0054c1]">Dự án</a>
        <a href="/blog" class="hover:text-[#0054c1]">Blog</a>
        <a href="mailto:htlabs.xyz@gmail.com" class="hover:text-[#0054c1]">Liên hệ</a>
      </nav>
    </div>
  </footer>
</main>

<script>
  const dialog = document.querySelector('#product-preview-dialog');
  const previewImage = dialog?.querySelector('[data-preview-image]');
  const previewTitle = dialog?.querySelector('#product-preview-title');
  const closeButton = dialog?.querySelector('[data-preview-close]');
  let activeTrigger: HTMLElement | null = null;

  if (dialog instanceof HTMLDialogElement && previewImage instanceof HTMLImageElement && previewTitle) {
    document.querySelectorAll<HTMLElement>('[data-product-preview]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        activeTrigger = trigger;
        previewImage.src = trigger.dataset.image ?? '';
        previewImage.alt = trigger.dataset.alt ?? '';
        previewTitle.textContent = trigger.dataset.title ?? '';
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      activeTrigger?.focus();
      activeTrigger = null;
    });
  }
</script>

<style>

  .preview-dialog {
    border: 0;
  }

  .preview-dialog::backdrop {
    background: rgba(2, 6, 23, 0.82);
    backdrop-filter: blur(8px);
  }

  .product-card {
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 68px rgba(0, 84, 193, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card:hover {
      transform: none;
    }
  }
</style>
