---
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');
projects.sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => !p.data.isPlaceholder);
const placeholders = projects.filter((p) => p.data.isPlaceholder);
---

<section id="portfolio" class="py-24 px-6 md:px-12 max-w-7xl mx-auto relative z-20 border-t border-white/5">
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-2 h-2 rounded-full bg-orange-500"></div>
      <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest">Portfolio</span>
    </div>
    <h2 class="text-2xl md:text-3xl tracking-tight font-medium text-white mb-4">Proof in production.</h2>
    <p class="text-zinc-400 text-sm md:text-base max-w-xl font-light">Real systems deployed, running in production, delivering measurable results.</p>
  </div>

  {featured && (
    <div class="mb-6 relative w-full aspect-[16/9] rounded-2xl overflow-hidden border border-white/10 group bg-zinc-900">
      {featured.data.coverImage ? (
        <img src={featured.data.coverImage} alt={featured.data.title} class="w-full h-full object-cover mix-blend-luminosity opacity-50 group-hover:opacity-80 transition-opacity duration-700" />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900 flex items-center justify-center">
          <iconify-icon icon="solar:box-linear" style="stroke-width: 1" class="text-zinc-700 text-8xl"></iconify-icon>
        </div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent opacity-90"></div>

      <div class="absolute bottom-8 left-8 right-8">
        <div class="flex items-center gap-2 mb-3">
          {featured.data.tags?.map((tag) => (
            <span class="text-xs font-mono text-orange-400 px-2 py-0.5 rounded-full bg-orange-500/10 border border-orange-500/20">{tag}</span>
          ))}
        </div>
        <h3 class="text-2xl md:text-3xl font-medium text-white tracking-tight mb-2">{featured.data.title}</h3>
        <p class="text-sm text-zinc-400 font-light max-w-xl">{featured.data.description}</p>
      </div>
    </div>
  )}

  {placeholders.length > 0 && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {placeholders.map((project) => (
        <div class="p-12 rounded-2xl border border-white/5 bg-white/[0.01] flex items-center justify-center opacity-60">
          <span class="text-sm font-mono text-zinc-600">Coming soon</span>
        </div>
      ))}
    </div>
  )}
</section>
