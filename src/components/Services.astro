---
import { getCollection } from 'astro:content';

const services = await getCollection('services');
services.sort((a, b) => a.data.order - b.data.order);
const featured = services.find((s) => s.data.isFeatured);
const others = services.filter((s) => !s.data.isFeatured);
---

<section id="services" class="py-24 px-6 md:px-12 max-w-7xl mx-auto relative z-20">
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-2 h-2 rounded-full bg-orange-500"></div>
      <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest">Our Services</span>
    </div>
    <h2 class="text-2xl md:text-3xl tracking-tight font-medium text-white mb-4">End-to-end AI capabilities.</h2>
    <p class="text-zinc-400 text-sm md:text-base max-w-xl font-light">HT Labs delivers end-to-end AI solutions — infrastructure, agents, integration, and strategy — so businesses can adopt AI without juggling multiple vendors.</p>
  </div>

  {featured && (
    <div class="p-8 rounded-2xl bg-white/[0.02] border-2 border-orange-500/30 hover:border-orange-500/50 transition-colors duration-300 group mb-6">
      <div class="flex items-start gap-6">
        <div class="w-12 h-12 rounded-xl border border-orange-500/20 bg-orange-500/5 flex items-center justify-center flex-shrink-0 text-orange-400 group-hover:text-orange-300 transition-colors">
          <iconify-icon icon={featured.data.icon} style="stroke-width: 1.5" class="text-2xl"></iconify-icon>
        </div>
        <div>
          <h3 class="text-xl font-medium text-white tracking-tight mb-2">{featured.data.title}</h3>
          <p class="text-sm text-zinc-400 font-light leading-relaxed">{featured.data.description}</p>
        </div>
      </div>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {others.map((service) => (
      <div class="p-8 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-white/10 transition-colors duration-300 group">
        <div class="w-10 h-10 rounded-lg border border-white/10 bg-white/5 flex items-center justify-center mb-8 text-zinc-300 group-hover:text-white transition-colors">
          <iconify-icon icon={service.data.icon} style="stroke-width: 1.5" class="text-xl"></iconify-icon>
        </div>
        <h3 class="text-lg font-medium text-white tracking-tight mb-2">{service.data.title}</h3>
        <p class="text-sm text-zinc-400 font-light leading-relaxed">{service.data.description}</p>
      </div>
    ))}
  </div>
</section>
