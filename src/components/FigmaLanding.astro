---
import SiteHeader from './SiteHeader.astro';

const aiTools = Array.from({ length: 8 }, (_, index) => ({
  src: `/figma-assets/ai-tool-${String(index + 1).padStart(2, '0')}.png`,
  alt: [
    'Claude',
    'OpenAI',
    'Gemini',
    'Meta AI',
    'Grok',
    'Mistral',
    'DeepSeek',
    'Qwen',
  ][index],
}));

const capabilities = [
  {
    label: 'Agent chat',
    title: 'Nền tảng AI Chatbot đa kênh',
    body: 'Tự động hóa quy trình tư vấn, hỗ trợ chốt đơn 24/7 và tích hợp liền mạch trên đa nền tảng.',
    color: '#64B9FF',
  },
  {
    label: 'Agent workflow',
    title: 'Trợ lý AI cho Mạng xã hội',
    body: 'Thu thập dữ liệu, tự động gửi email, lên lịch nội dung, phân tích xu hướng và tối ưu chiến dịch.',
    color: '#A3C3FF',
  },
  {
    label: 'CRM Agent',
    title: 'Hệ thống CRM thông minh',
    body: 'Hệ thống CRM tuỳ chỉnh kết hợp phân tích sản phẩm, theo dõi hành vi người dùng.',
    color: '#43BD9C',
  },
  {
    label: 'Digital human',
    title: 'Livestream bán hàng tự động',
    body: 'Tạo và phát video trực tiếp tự động, trả lời bình luận và bán hàng xuyên suốt 24/7.',
    color: '#FFC095',
  },
];

const processSteps = [
  {
    title: 'Khảo sát và đánh giá thực trạng hệ thống dữ liệu hiện tại',
    color: '#B1FCFF',
    className: 'lg:col-span-5',
  },
  {
    title: 'Đề xuất và thiết kế mô hình AI tích hợp',
    color: '#80DFFF',
    className: 'lg:col-span-3',
  },
  {
    title: 'Thử nghiệm, tinh chỉnh thuật toán và đào tạo đội ngũ vận hành',
    color: '#90C9FB',
    className: 'lg:col-span-3',
  },
  {
    title: 'Bàn giao hệ thống, cung cấp tài liệu kỹ thuật và bảo trì định kỳ',
    color: '#B6BBFF',
    className: 'lg:col-span-5',
  },
];

const commitments = [
  {
    title: 'Hỗ trợ kỹ thuật 24/7',
    body: 'Phản hồi trực tiếp trong vòng 24h từ kỹ sư cấp cao của HTLabs.',
    color: '#AEB4FF',
  },
  {
    title: 'Tại chỗ & Từ xa',
    body: 'Làm việc trực tiếp tại doanh nghiệp hoặc từ xa cùng một chuẩn chất lượng.',
    color: '#AEFFF1',
  },
  {
    title: 'SLA minh bạch',
    body: 'Tiến độ rõ ràng, trách nhiệm và quy trình xử lý rõ ràng.',
    color: '#FFF3AE',
  },
];
---

<main class="premium-page min-h-screen w-full overflow-x-hidden bg-white text-black">
  <SiteHeader home currentPage="home" />

  <section class="hero-canvas mx-auto flex w-full max-w-[1220px] flex-col items-center px-5 pb-24 pt-24 text-center md:px-8 md:pb-36 md:pt-32">
    <p class="mb-8 rounded-full border border-black/10 bg-white px-4 py-2 text-[13px] font-semibold text-[#006f77] shadow-sm">
      HTLabs AI Operations Studio
    </p>
    <h1 class="max-w-[1080px] text-[clamp(3rem,7vw,5.65rem)] font-semibold leading-[1.06] tracking-normal text-balance">
      Giải Pháp <span class="figma-gradient-text">AI Toàn Diện</span> Cho Doanh Nghiệp
    </h1>
    <p class="mt-9 max-w-[800px] text-[18px] font-medium leading-[1.7] text-black/74 md:text-[22px]">
      Giải quyết bài toán về tối ưu quy trình, nâng cao hiệu suất và giảm thiểu chi phí với mô hình AI tự động hoá thông minh.
    </p>

    <div class="mt-10 flex w-full flex-col items-stretch justify-center gap-4 sm:w-auto sm:flex-row">
      <a href="mailto:htlabs.xyz@gmail.com" class="figma-gradient-bg inline-flex min-h-[54px] items-center justify-center rounded-full px-8 text-[16px] font-semibold text-white shadow-[0_18px_44px_rgba(0,84,193,0.22)] transition-transform hover:-translate-y-0.5 md:min-h-[60px] md:px-10 md:text-[18px]">
        Đặt lịch tư vấn
      </a>
      <a href="#capabilities" class="inline-flex min-h-[54px] items-center justify-center rounded-full border-2 border-[#0054c1] bg-white px-8 text-[16px] font-semibold text-[#0054c1] shadow-[0_14px_36px_rgba(0,84,193,0.08)] transition-all hover:-translate-y-0.5 hover:bg-[#f4f8ff] md:min-h-[60px] md:px-10 md:text-[18px]">
        Khám phá sản phẩm
      </a>
    </div>
  </section>

  <section id="discovery" class="mx-auto flex w-full max-w-[1080px] flex-col items-center px-5 py-20 text-center md:px-8 md:py-28">
    <h2 class="max-w-[900px] text-[32px] font-semibold leading-[1.18] md:text-[52px]">
      Bạn muốn AI giải quyết vấn đề gì?
    </h2>
    <p class="mt-6 max-w-[740px] text-[17px] font-medium leading-[1.7] text-black/72 md:text-[21px]">
      Cung cấp mô hình, workflow đơn giản hỗ trợ doanh nghiệp trong lĩnh vực bán hàng, marketing, CRM và hơn thế nữa...
    </p>

    <label class="mt-12 flex min-h-[96px] w-full items-center gap-4 rounded-[28px] border border-black bg-[#f4f3f1] px-6 text-left shadow-[0_22px_60px_rgba(0,0,0,0.06)] md:min-h-[128px] md:rounded-[34px] md:px-10">
      <span class="sr-only">Tìm kiếm giải pháp</span>
      <input
        type="text"
        placeholder="Tìm kiếm giải pháp cho...."
        disabled
        aria-disabled="true"
        class="min-w-0 flex-1 cursor-not-allowed bg-transparent text-[18px] font-medium text-black outline-none placeholder:text-[#62646c] disabled:opacity-60 md:text-[22px]"
      />
      <button type="button" aria-label="Tìm kiếm — tạm thời chưa khả dụng" disabled aria-disabled="true" class="figma-gradient-bg flex size-11 shrink-0 cursor-not-allowed items-center justify-center rounded-full text-white opacity-50 shadow-[0_12px_28px_rgba(0,134,131,0.22)] md:size-13">
        <iconify-icon icon="solar:arrow-right-linear" class="text-2xl"></iconify-icon>
      </button>
    </label>
  </section>

  <section class="mx-auto flex w-full max-w-[1080px] flex-col items-center px-5 py-24 text-center md:px-8 md:py-32">
    <h2 class="max-w-[960px] text-[32px] font-semibold leading-[1.18] md:text-[52px]">
      Được vận hành bởi các công cụ AI hàng đầu thị trường.
    </h2>
    <p class="mt-8 max-w-[940px] text-[17px] font-medium leading-[1.7] text-black/72 md:text-[21px]">
      Chúng tôi liên tục cập nhật và tích hợp các mô hình AI tiên tiến nhất để đem đến giải pháp hiệu quả, chính xác và tối ưu chi phí cho khách hàng
    </p>

    <div class="mt-14 grid w-full grid-cols-2 gap-4 sm:grid-cols-4 md:gap-6">
      {aiTools.map((tool) => (
        <div class="group flex aspect-[1.4] items-center justify-center rounded-[22px] border border-black bg-[#f4f4f4] p-7 shadow-[0_14px_34px_rgba(0,0,0,0.04)] transition-transform hover:-translate-y-1 md:rounded-[28px]">
          <img src={tool.src} alt={tool.alt} loading="lazy" class="max-h-20 max-w-28 object-contain transition-transform duration-300 group-hover:scale-105 md:max-h-24 md:max-w-32" />
        </div>
      ))}
    </div>
  </section>

  <section id="capabilities" class="mx-auto w-full max-w-[1220px] px-5 py-24 md:px-8 md:py-36">
    <h2 class="mx-auto max-w-[980px] text-center text-[32px] font-semibold leading-[1.18] md:text-[52px]">
      Nâng tầm doanh nghiệp với các Giải pháp AI cốt lõi
    </h2>

    <div class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {capabilities.map((item) => (
        <article class="taste-card flex min-h-[430px] flex-col rounded-[28px] border border-black/10 p-7 text-black shadow-[0_24px_70px_rgba(0,0,0,0.08)] transition-transform hover:-translate-y-1 md:min-h-[520px] md:rounded-[32px] md:p-8" style={`background:${item.color}`}>
          <p class="text-[16px] font-medium md:text-[19px]">{item.label}</p>
          <h3 class="relative z-10 mt-8 text-[32px] font-semibold leading-[1.1] md:text-[43px]">{item.title}</h3>
          <p class="relative z-10 mt-auto pt-12 text-[18px] font-medium leading-[1.5] text-black/78 md:text-[22px]">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="process" class="mx-auto w-full max-w-[1220px] px-5 py-24 md:px-8 md:py-36">
    <h2 class="mx-auto max-w-[1040px] text-center text-[32px] font-semibold leading-[1.18] md:text-[52px]">
      Triển khai nhanh chóng và bảo mật cho từng mô hình doanh nghiệp
    </h2>

    <div class="mt-16 grid gap-4 lg:grid-cols-8">
      {processSteps.map((step) => (
        <article class={`${step.className} taste-card flex min-h-[210px] items-center rounded-[28px] border border-black/10 p-8 text-black shadow-[0_20px_54px_rgba(0,0,0,0.06)] md:min-h-[260px] md:rounded-[32px] md:p-12`} style={`background:${step.color}`}>
          <h3 class="relative z-10 max-w-[720px] text-[26px] font-semibold leading-[1.18] md:text-[38px]">{step.title}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto w-full max-w-[1120px] px-5 py-24 text-center md:px-8 md:py-36">
    <h2 class="mx-auto max-w-[980px] text-[32px] font-semibold leading-[1.18] md:text-[52px]">
      Cam kết dịch vụ AI và IT chất lượng cao
    </h2>
    <p class="mx-auto mt-8 max-w-[1050px] text-[17px] font-medium leading-[1.7] text-black/72 md:text-[21px]">
      Đồng hành cùng sự phát triển của khách hàng là lý do HTLabs được chọn làm đối tác IT dài hạn. Chúng tôi đi cùng doanh nghiệp của bạn trên con đường chuyển đổi số toàn diện.
    </p>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {commitments.map((item) => (
        <article class="taste-card min-h-[330px] rounded-[28px] border border-black/10 p-8 text-left text-black shadow-[0_20px_54px_rgba(0,0,0,0.06)] transition-transform hover:-translate-y-1 md:min-h-[390px] md:rounded-[32px] md:p-10" style={`background:${item.color}`}>
          <h3 class="relative z-10 text-[31px] font-semibold leading-[1.14] md:text-[42px]">{item.title}</h3>
          <p class="relative z-10 mt-8 text-[18px] font-medium leading-[1.55] text-black/76 md:text-[21px]">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="mx-auto flex w-full max-w-[1080px] flex-col items-center px-5 py-24 text-center md:px-8 md:py-32">
    <div class="w-full rounded-[36px] border border-black/10 bg-[#f4f3f1] px-6 py-16 shadow-[0_24px_70px_rgba(0,0,0,0.07)] md:px-10 md:py-20">
    <h2 class="text-[32px] font-semibold leading-[1.18] md:text-[52px]">Bạn đang mong đợi điều gì?</h2>
    <a href="mailto:htlabs.xyz@gmail.com" class="figma-gradient-bg mt-10 inline-flex min-h-[58px] items-center justify-center rounded-full px-10 text-[17px] font-semibold text-white shadow-[0_18px_44px_rgba(0,84,193,0.22)] transition-transform hover:-translate-y-0.5 md:min-h-[64px] md:px-16 md:text-[20px]">
      Đặt lịch tư vấn miễn phí
    </a>
    </div>
  </section>

  <footer class="mx-auto w-full max-w-[1220px] px-5 pb-12 pt-12 md:px-8 md:pb-16 md:pt-16">
    <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <img src="/figma-assets/htlabs-logo-footer.svg" alt="HTLabs" class="h-auto w-[150px] md:w-[176px]" />
        <p class="mt-7 max-w-[420px] text-[15px] font-medium leading-[1.55] text-black md:text-[17px]">
          Trí tuệ vận hành và tự động hoá quy trình. Chúng tôi loại bỏ thao tác thủ công trên toàn bộ hệ thống của bạn.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-16 gap-y-4 text-[15px] font-medium text-black md:gap-x-28 md:text-[17px]">
        <h3 class="font-bold">Khám phá</h3>
        <h3 class="font-bold">Công ty</h3>
        <a href="/products" class="hover:text-[#0054c1]">Dự án</a>
        <a href="/" class="hover:text-[#0054c1]">Về HTLabs</a>
        <a href="#process" class="hover:text-[#0054c1]">Quy trình</a>
        <a href="#contact" class="hover:text-[#0054c1]">Liên hệ</a>
        <a href="/blog" class="hover:text-[#0054c1]">Blog</a>
      </div>
    </div>
  </footer>
</main>
