---
import Header from './Header.astro';
---

<section class="relative w-full min-h-screen overflow-hidden border-b border-white/5">
  <div class="absolute inset-0 pointer-events-none grid-overlay z-0"></div>

  <div class="absolute -top-32 -left-32 w-[40rem] h-[40rem] bg-orange-500/10 blur-[140px] rounded-full z-0 pointer-events-none"></div>
  <div class="absolute top-1/3 -right-40 w-[36rem] h-[36rem] bg-blue-500/[0.06] blur-[140px] rounded-full z-0 pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[60rem] h-[20rem] bg-orange-500/[0.04] blur-[120px] rounded-full z-0 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 py-6 md:py-10 min-h-screen flex flex-col">
  <Header home={true} />

  <div class="relative z-20 flex-1 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center mt-12 lg:mt-0">
    <div class="lg:col-span-7 animate-fade-in opacity-0" style="animation-delay: 0.15s">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.03] backdrop-blur-sm mb-8">
        <div class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></div>
        <span class="font-mono text-[11px] text-zinc-300 uppercase tracking-[0.18em]">HT Labs · Comprehensive AI</span>
      </div>

      <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] xl:text-[6.5rem] text-white leading-[0.95] tracking-tighter font-medium text-balance">
        Build with
        <span class="relative inline-block">
          <span class="bg-gradient-to-br from-orange-300 via-orange-500 to-amber-600 bg-clip-text text-transparent">intelligent</span>
        </span>
        <br />
        systems,
        <span class="text-zinc-600 italic font-light">end-to-end.</span>
      </h1>

      <p class="mt-8 max-w-xl text-base md:text-lg text-zinc-400 font-light leading-relaxed">
        From infrastructure to agents to integration — we deliver complete AI solutions for businesses ready to operate with intelligence.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="mailto:htlabs.xyz@gmail.com" class="group flex items-center gap-2 bg-white text-black px-5 py-3 rounded-full hover:bg-zinc-200 transition-all duration-200 font-medium text-sm shadow-lg shadow-white/5">
          Start a project
          <iconify-icon icon="solar:arrow-right-linear" style="stroke-width: 1.5" class="text-base group-hover:translate-x-0.5 transition-transform"></iconify-icon>
        </a>
        <a href="#services" class="group flex items-center gap-2 px-5 py-3 rounded-full border border-white/10 hover:border-white/20 hover:bg-white/5 transition-all duration-200 text-sm text-zinc-200">
          Explore services
          <iconify-icon icon="solar:arrow-down-linear" style="stroke-width: 1.5" class="text-base group-hover:translate-y-0.5 transition-transform"></iconify-icon>
        </a>
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/5">
          <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="font-mono text-xs text-emerald-300 tracking-wide">Accepting Projects</span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 animate-fade-in opacity-0" style="animation-delay: 0.35s">
      <div class="relative">
        <div class="absolute -inset-4 bg-gradient-to-tr from-orange-500/10 via-transparent to-blue-500/10 blur-2xl rounded-3xl"></div>

        <div class="relative tech-glass rounded-2xl p-5 space-y-3">
          <div class="flex items-center justify-between pb-3 border-b border-white/5">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-red-500/70"></div>
              <div class="w-2 h-2 rounded-full bg-amber-500/70"></div>
              <div class="w-2 h-2 rounded-full bg-emerald-500/70"></div>
            </div>
            <span class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest"></span>
          </div>

          <div class="group flex items-center gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-orange-500/30 hover:bg-white/[0.04] transition-all">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
              <iconify-icon icon="solar:chat-round-dots-linear" class="text-xl text-orange-400"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span class="text-sm text-white font-medium">AI Chatbot</span>
                <span class="font-mono text-[10px] text-emerald-400">● online</span>
              </div>
              <span class="text-xs text-zinc-500">24/7 customer care · auto-routing</span>
            </div>
          </div>

          <div class="group flex items-center gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-orange-500/30 hover:bg-white/[0.04] transition-all">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
              <iconify-icon icon="solar:hashtag-square-linear" class="text-xl text-blue-400"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span class="text-sm text-white font-medium">Social Agents</span>
                <span class="font-mono text-[10px] text-emerald-400">● online</span>
              </div>
              <span class="text-xs text-zinc-500">content · trends · engagement</span>
            </div>
          </div>

          <div class="group flex items-center gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-orange-500/30 hover:bg-white/[0.04] transition-all">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
              <iconify-icon icon="solar:chart-square-linear" class="text-xl text-emerald-400"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span class="text-sm text-white font-medium">CRM & Analytics</span>
                <span class="font-mono text-[10px] text-emerald-400">● online</span>
              </div>
              <span class="text-xs text-zinc-500">behavior · funnels · lifecycle</span>
            </div>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-white/5">
            <span class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">uptime</span>
            <div class="flex items-center gap-2">
              <div class="flex gap-0.5">
                <div class="w-1 h-3 bg-emerald-500/80 rounded-sm"></div>
                <div class="w-1 h-3 bg-emerald-500/80 rounded-sm"></div>
                <div class="w-1 h-3 bg-emerald-500/80 rounded-sm"></div>
                <div class="w-1 h-3 bg-emerald-500/80 rounded-sm"></div>
                <div class="w-1 h-3 bg-emerald-500/80 rounded-sm"></div>
                <div class="w-1 h-3 bg-emerald-500/60 rounded-sm"></div>
                <div class="w-1 h-3 bg-emerald-500/80 rounded-sm"></div>
              </div>
              <span class="font-mono text-[10px] text-zinc-400"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-20 mt-12 lg:mt-8 grid grid-cols-2 md:grid-cols-4 gap-px bg-white/5 border border-white/5 rounded-xl overflow-hidden animate-fade-in opacity-0" style="animation-delay: 0.5s">
    <div class="bg-zinc-950/80 backdrop-blur-sm p-5">
      <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-2">Pillars</div>
      <div class="text-2xl text-white font-medium tracking-tight">3 / Layers</div>
    </div>
    <div class="bg-zinc-950/80 backdrop-blur-sm p-5">
      <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-2">Approach</div>
      <div class="text-2xl text-white font-medium tracking-tight">End-to-end</div>
    </div>
    <div class="bg-zinc-950/80 backdrop-blur-sm p-5">
      <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-2">Founded</div>
      <div class="text-2xl text-white font-medium tracking-tight">2024</div>
    </div>
    <div class="bg-zinc-950/80 backdrop-blur-sm p-5">
      <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-2">Status</div>
      <div class="text-2xl text-white font-medium tracking-tight flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Available
      </div>
    </div>
  </div>
  </div>
</section>
