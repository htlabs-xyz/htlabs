---
import { getCollection } from 'astro:content';

const partners = await getCollection('partners');
partners.sort((a, b) => a.data.order - b.data.order);
---

<section class="py-24 px-6 md:px-12 max-w-7xl mx-auto relative z-20 border-t border-white/5">
  <div class="text-center mb-16 max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-4 justify-center">
      <div class="w-2 h-2 rounded-full bg-orange-500"></div>
      <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest">Partners</span>
    </div>
    <h2 class="text-3xl md:text-4xl tracking-tight font-medium text-white mb-4">Trusted by industry leaders.</h2>
    <p class="text-sm md:text-base text-zinc-400 font-light text-balance leading-relaxed">We collaborate with forward-thinking companies to deliver AI that makes a real operational impact.</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto">
    {partners.map((partner) => (
      <div class="group p-8 rounded-2xl bg-white/[0.01] border border-white/5 hover:bg-white/[0.03] hover:border-white/10 transition-all flex items-center justify-center cursor-pointer relative overflow-hidden">
        {partner.data.isPlaceholder ? (
          <span class="text-sm font-mono text-zinc-600">Coming soon</span>
        ) : (
          <span class="text-sm font-medium text-zinc-300 group-hover:text-white transition-colors">{partner.data.name}</span>
        )}
      </div>
    ))}
  </div>
</section>
