---
const aiTools = [
  { name: 'Claude', icon: 'simple-icons:anthropic' },
  { name: 'GPT-5', icon: 'simple-icons:openai' },
  { name: 'Gemini', icon: 'simple-icons:googlegemini' },
  { name: 'Llama', icon: 'simple-icons:meta' },
  { name: 'Grok', icon: 'simple-icons:x' },
  { name: 'Mistral', icon: 'simple-icons:mistralai' },
  { name: 'DeepSeek', icon: 'simple-icons:deepseek' },
  { name: 'Qwen', icon: 'simple-icons:alibabacloud' },
];
---

<section class="py-24 px-6 md:px-12 max-w-7xl mx-auto relative z-20 border-t border-white/5">
  <div class="text-center mb-16 max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-4 justify-center">
      <div class="w-2 h-2 rounded-full bg-orange-500"></div>
      <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest" data-i18n="partners.eyebrow">AI Stack</span>
    </div>
    <h2 class="text-3xl md:text-4xl tracking-tight font-medium text-white mb-4" data-i18n="partners.title">Powered by the latest AI tools on the market.</h2>
    <p class="text-sm md:text-base text-zinc-400 font-light text-balance leading-relaxed" data-i18n="partners.body">We continuously adopt and integrate leading AI models and platforms to deliver effective, accurate, and cost-optimized solutions for our clients.</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto">
    {aiTools.map((tool) => (
      <div class="group p-8 rounded-2xl bg-white/[0.01] border border-white/5 hover:bg-white/[0.03] hover:border-white/10 transition-all flex items-center justify-center cursor-pointer relative overflow-hidden min-h-[120px]" title={tool.name}>
        <iconify-icon
          icon={tool.icon}
          class="text-4xl text-zinc-400 group-hover:text-white transition-colors"
        ></iconify-icon>
      </div>
    ))}
  </div>
</section>
