---
import { getCollection } from 'astro:content';

const members = await getCollection('team');
members.sort((a, b) => a.data.order - b.data.order);
---

<section id="team" class="py-24 px-6 md:px-12 max-w-7xl mx-auto relative z-20 border-t border-white/5">
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-2 h-2 rounded-full bg-orange-500"></div>
      <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest">Our Team</span>
    </div>
    <h2 class="text-2xl md:text-3xl tracking-tight font-medium text-white mb-4">The people behind the intelligence.</h2>
    <p class="text-zinc-400 text-sm md:text-base max-w-xl font-light">A focused team of engineers, architects, and strategists building AI solutions that work in production.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {members.map((member) => (
      <div class={`p-6 rounded-2xl bg-white/[0.02] border transition-colors duration-300 group ${member.data.isPlaceholder ? 'border-white/5 opacity-60' : 'border-white/5 hover:border-white/10'}`}>
        {member.data.isPlaceholder ? (
          <div class="w-16 h-16 rounded-full bg-zinc-800/50 border border-white/5 flex items-center justify-center mb-4 mx-auto">
            <span class="text-sm font-mono text-zinc-600">{member.data.initials}</span>
          </div>
        ) : (
          <div class="w-16 h-16 rounded-full bg-orange-500/20 border border-orange-500/20 flex items-center justify-center mb-4 mx-auto">
            <span class="text-lg font-medium text-orange-400">{member.data.initials}</span>
          </div>
        )}
        <h3 class={`text-center tracking-tight mb-1 ${member.data.isPlaceholder ? 'text-zinc-600 font-light' : 'text-white font-medium'}`}>{member.data.name}</h3>
        <p class="text-center text-xs font-mono text-zinc-500 uppercase tracking-wide">{member.data.role}</p>
      </div>
    ))}
  </div>
</section>
