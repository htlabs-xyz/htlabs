---
import { getCollection } from 'astro:content';

const members = await getCollection('team');
members.sort((a, b) => a.data.order - b.data.order);
---

<section id="team" class="py-24 px-6 md:px-12 max-w-7xl mx-auto relative z-20 border-t border-white/5">
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-2 h-2 rounded-full bg-orange-500"></div>
      <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest" data-i18n="team.eyebrow">Our Team</span>
    </div>
    <h2 class="text-2xl md:text-3xl tracking-tight font-medium text-white mb-4" data-i18n="team.title">The people behind the intelligence.</h2>
    <p class="text-zinc-400 text-sm md:text-base max-w-xl font-light" data-i18n="team.body">A focused team of engineers, architects, and strategists building AI solutions that work in production.</p>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
    {members.map((member) => (
      <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-white/10 transition-colors duration-300 group flex flex-col items-center">
        {member.data.photoUrl ? (
          <img src={member.data.photoUrl} alt={member.data.name} class="w-40 h-40 rounded-full object-cover border border-orange-500/20 mb-5" />
        ) : (
          <div class="w-40 h-40 rounded-full bg-orange-500/20 border border-orange-500/20 flex items-center justify-center mb-5">
            <span class="text-3xl font-medium text-orange-400">{member.data.initials}</span>
          </div>
        )}
        <h3 class="text-center tracking-tight mb-1 text-white font-medium">{member.data.name}</h3>
        <p class="text-center text-xs font-mono text-zinc-500 uppercase tracking-wide">{member.data.role}</p>
      </div>
    ))}
  </div>
</section>
