# All runtime integration remains off until the license and contract gates pass.
GOCLAW_INTEGRATION_ENABLED=false
GOCLAW_LICENSE_APPROVED=false

# Bootstrap/probe targets must be server-side only. Never expose these values to a browser.
GOCLAW_BASE_URL=http://127.0.0.1:18790
GOCLAW_ADMIN_TOKEN=
GOCLAW_OWNER_USER_ID=
GOCLAW_PROVIDER=
GOCLAW_MODEL=
GOCLAW_BOOTSTRAP_SECRETS_FILE=

# Created by an operator after importing the agent. Keep both values secret.
GOCLAW_WEBHOOK_ID=
GOCLAW_WEBHOOK_HMAC_KEY=

# The proxy, not the browser, generates this opaque value.
GOCLAW_CONTRACT_SESSION_KEY=contract-fixture-session

# Remote bootstrap/probes are separately blocked. Localhost is the safe default.
GOCLAW_ALLOW_REMOTE_ADMIN=false
GOCLAW_ALLOW_LLM_CONTRACT_PROBE=false
